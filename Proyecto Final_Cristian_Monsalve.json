      "parameters": {
        "jsCode": "// Se toma el mensaje del trigger\nconst item = $input.first().json;\nconst mensaje = item.message?.text?.trim() || '';\nconst chatId = item.message?.chat?.id;\nconst usuarioId = item.message?.from?.id;\nconst nombre = item.message?.from?.first_name || 'Usuario';\n\n// Si el mensaje está vacío, se prepara una respuesta rápida\nif (mensaje === '') {\n  return [{\n    json: {\n      vacio: true,\n      chatId: chatId,\n      respuesta: 'Por favor, escribe algo 😊'\n    }\n  }];\n}\n\n// Si hay mensaje, se devuelven los datos limpios\nreturn [{\n  json: {\n    vacio: false,\n    chatId: chatId,\n    usuarioId: usuarioId,\n    nombre: nombre,\n    textoLimpio: mensaje\n  }\n}];"
      },
